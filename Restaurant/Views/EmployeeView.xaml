<Window x:Class="Restaurant.Views.EmployeeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Restaurant.Views"
        mc:Ignorable="d"
        Title="Restaurant Management System" Height="650" Width="1000"
        Background="#F0F2F5">

    <Window.Resources>
        <Style x:Key="ModernTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="#F0F2F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Padding="{TemplateBinding Padding}" 
                                BorderThickness="0,0,0,3" BorderBrush="Transparent" 
                                Background="{TemplateBinding Background}" CornerRadius="4,4,0,0">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#1976D2"/>
                                <Setter TargetName="Border" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>

        <Style x:Key="FilterButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="BorderBrush" Value="#2196F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F5F5F5"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E0E0E0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>

        <Style x:Key="ModernGroupBox" TargetType="GroupBox">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#2196F3" CornerRadius="4,4,0,0" Padding="10,5">
                                <TextBlock Text="{TemplateBinding Header}" Foreground="White" FontWeight="SemiBold"/>
                            </Border>
                            <Border Grid.Row="1" Background="White" BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="0,0,4,4">
                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <TextBlock Text="Restaurant Management System" FontSize="22" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Style="{StaticResource ModernTabControl}">

            <!-- Menu Management Tab -->
            <TabItem Header="Meniu" Style="{StaticResource ModernTabItem}">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Categories -->
                    <GroupBox Header="Categories" Style="{StaticResource ModernGroupBox}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Add" Command="{Binding AddCategoryCommand}" Style="{StaticResource ActionButton}"/>
                                <Button Content="Edit" Command="{Binding EditCategoryCommand}" Style="{StaticResource ActionButton}"/>
                                <Button Content="Delete" Command="{Binding DeleteCategoryCommand}" Style="{StaticResource ActionButton}" Background="#F44336"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Categories}"
                                   SelectedItem="{Binding SelectedCategory}"
                                   AutoGenerateColumns="False"
                                   CanUserAddRows="False"
                                   IsReadOnly="True"
                                   Style="{StaticResource ModernDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>

                    <!-- Dishes -->
                    <GroupBox Header="Dishes" Grid.Column="1" Style="{StaticResource ModernGroupBox}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Add" Command="{Binding AddDishCommand}" Style="{StaticResource ActionButton}"/>
                                <Button Content="Edit" Command="{Binding EditDishCommand}" Style="{StaticResource ActionButton}"/>
                                <Button Content="Delete" Command="{Binding DeleteDishCommand}" Style="{StaticResource ActionButton}" Background="#F44336"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Dishes}"
                                   SelectedItem="{Binding SelectedDish}"
                                   AutoGenerateColumns="False"
                                   CanUserAddRows="False"
                                   IsReadOnly="True"
                                   Style="{StaticResource ModernDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="*" />
                                    <DataGridTextColumn Header="Portion Qty" Binding="{Binding QuantityPerPortion}" Width="*" />
                                    <DataGridTextColumn Header="Total Qty" Binding="{Binding TotalQuantity}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>

                    <!-- Menus -->
                    <GroupBox Header="Menus" Grid.Row="1" Style="{StaticResource ModernGroupBox}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Add" Command="{Binding AddMenuCommand}" Style="{StaticResource ActionButton}"/>
                                <Button Content="Edit" Command="{Binding EditMenuCommand}" Style="{StaticResource ActionButton}"/>
                                <Button Content="Delete" Command="{Binding DeleteMenuCommand}" Style="{StaticResource ActionButton}" Background="#F44336"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Menus}"
                                   SelectedItem="{Binding SelectedMenu}"
                                   AutoGenerateColumns="False"
                                   CanUserAddRows="False"
                                   IsReadOnly="True"
                                   Style="{StaticResource ModernDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                                    <DataGridTextColumn Header="Price" Binding="{Binding CalculatedPrice}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>

                    <!-- Allergens -->
                    <GroupBox Header="Allergens" Grid.Row="1" Grid.Column="1" Style="{StaticResource ModernGroupBox}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Add" Command="{Binding AddAllergenCommand}" Style="{StaticResource ActionButton}"/>
                                <Button Content="Edit" Command="{Binding EditAllergenCommand}" Style="{StaticResource ActionButton}"/>
                                <Button Content="Delete" Command="{Binding DeleteAllergenCommand}" Style="{StaticResource ActionButton}" Background="#F44336"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Allergens}"
                                   SelectedItem="{Binding SelectedAllergen}"
                                   AutoGenerateColumns="False"
                                   CanUserAddRows="False"
                                   IsReadOnly="True"
                                   Style="{StaticResource ModernDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Reports Tab -->
            <TabItem Header="Rapoarte" Style="{StaticResource ModernTabItem}">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Quick Filters -->
                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Order Filters" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Toate comenzile" 
                                        Command="{Binding LoadAllOrdersCommand}" 
                                        Style="{StaticResource FilterButton}"
                                        Background="{Binding DataContext.IsAllOrdersSelected, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Button Content="Comenzi active" 
                                        Command="{Binding LoadActiveOrdersCommand}" 
                                        Style="{StaticResource FilterButton}"
                                        Background="{Binding DataContext.IsOnlyActiveOrders, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Orders List -->
                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <DockPanel>
                            <TextBlock Text="Lista Comenzi" FontWeight="SemiBold" FontSize="18" DockPanel.Dock="Top" Margin="0,0,0,10"/>
                            <ListBox ItemsSource="{Binding DisplayedOrders}" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" Margin="0,5" CornerRadius="6" 
                                                Background="#FFFFFF" Width="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollContentPresenter}}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Order Details -->
                                                <StackPanel Grid.Column="0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Order Code and Date -->
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding OrderCode}" FontWeight="Bold" FontSize="16"/>
                                                            <TextBlock Text="{Binding OrderDate, StringFormat='Data: {0:dd.MM.yyyy HH:mm}'}" Foreground="#757575"/>
                                                        </StackPanel>

                                                        <!-- Status Badge -->
                                                        <Border Grid.Column="1" Background="#E3F2FD" CornerRadius="4" Padding="8,4">
                                                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Foreground="#1976D2"/>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Customer Info -->
                                                    <Border Background="#F5F5F5" CornerRadius="4" Padding="10" Margin="0,10,0,10">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding CustomerName, StringFormat='Client: {0}'}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding DeliveryAddress, StringFormat='Adresa livrare: {0}'}"/>
                                                            <TextBlock Text="{Binding EstimatedDeliveryTime, StringFormat='Estimare livrare: {0:t dd.MM}'}" Foreground="#757575"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Order Items -->
                                                    <TextBlock Text="Produse comandate:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                                    <ItemsControl ItemsSource="{Binding OrderDetails}" Margin="10,0,0,10">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding ItemName}" Grid.Column="0"/>
                                                                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                                                                        <TextBlock Text="x" Margin="0,0,4,0"/>
                                                                        <TextBlock Text="{Binding Quantity}" FontWeight="SemiBold" Margin="0,0,4,0"/>
                                                                        <TextBlock Text="buc."/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Low Stock Items -->
                    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15">
                        <DockPanel>
                            <TextBlock Text="Preparate aproape epuizate" FontWeight="SemiBold" FontSize="18" DockPanel.Dock="Top" Margin="0,0,0,10"/>
                            <ListBox ItemsSource="{Binding LowStockDishes}" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#FFEBEE" BorderThickness="1" Background="#FFEBEE" CornerRadius="6" Padding="15" Margin="0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Warning Icon -->
                                                <TextBlock Text="⚠" FontSize="20" Foreground="#F44336" Grid.Column="0" Margin="0,0,15,0" VerticalAlignment="Center"/>

                                                <!-- Dish Name -->
                                                <TextBlock Text="{Binding Name}" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                                <!-- Quantity Badge -->
                                                <Border Background="#F44336" CornerRadius="15" Padding="10,5" Grid.Column="2">
                                                    <TextBlock>
                                                        <Run Text="{Binding TotalQuantity}" Foreground="White" FontWeight="Bold"/>
                                                        <Run Text="g rămase" Foreground="White"/>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>