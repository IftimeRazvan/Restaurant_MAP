<Window x:Class="Restaurant.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Restaurant.Converters"
        Title="Autentificare - Restaurant" Height="720" Width="430"
        WindowStartupLocation="CenterScreen"
        Background="#FFF6F9FC">

    <Window.Resources>
        <!-- Convertori -->
        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <local:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter" />

        <!-- Culori personalizate din EmployeeView -->
        <Color x:Key="PrimaryColor">#FF3E8EDE</Color>
        <Color x:Key="AccentColor">#FF58C3B6</Color>
        <Color x:Key="BackgroundColor">#FFF6F9FC</Color>
        <Color x:Key="TextColor">#FF1E1E1E</Color>
        <Color x:Key="HeaderColor">#FF2A2A2A</Color>

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="HeaderBrush" Color="{StaticResource HeaderColor}"/>

        <!-- Stil pentru TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}">
                            <ScrollViewer Margin="0" x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stil pentru Button -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Gray" BlurRadius="5" ShadowDepth="1"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Margin="20">
                <TextBlock Text="Bine ai venit!" 
                           FontSize="24" FontWeight="Bold" Foreground="{StaticResource HeaderBrush}" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Autentifică-te sau creează un cont nou." 
                           FontSize="14" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <!-- Email login -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Email:" Width="100" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Width="250"/>
                </StackPanel>

                <!-- Parolă login -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Parolă:" Width="100" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                    <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Width="250"/>
                </StackPanel>

                <Button Content="Autentificare"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Height="40"/>

                <Separator Margin="0,20"/>

                <TextBlock Text="Nu ai cont? Creează unul mai jos:" 
                           FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="{StaticResource HeaderBrush}"/>

                <!-- Email înregistrare -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Email:" Width="100" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                    <TextBox Text="{Binding RegisterEmail, UpdateSourceTrigger=PropertyChanged}" Width="250"/>
                </StackPanel>

                <!-- Parolă înregistrare -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Parolă:" Width="100" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                    <TextBox Text="{Binding RegisterPassword, UpdateSourceTrigger=PropertyChanged}" Width="250"/>
                </StackPanel>

                <!-- Nume -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Nume:" Width="100" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                    <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Width="250"/>
                </StackPanel>

                <!-- Prenume -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Prenume:" Width="100" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                    <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Width="250"/>
                </StackPanel>

                <!-- Telefon -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Telefon:" Width="100" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                    <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Width="250"/>
                </StackPanel>

                <!-- Adresă -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Adresă:" Width="100" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                    <TextBox Text="{Binding DeliveryAddress, UpdateSourceTrigger=PropertyChanged}" Width="250"/>
                </StackPanel>

                <!-- Buton Înregistrare -->
                <Button Content="Creează cont"
                        Command="{Binding RegisterCommand}"
                        Background="{StaticResource AccentBrush}"
                        Height="40"
                        Width="150"
                        HorizontalAlignment="Center"/>

                <!-- Mesaj -->
                <TextBlock Text="{Binding Message}"
                           Foreground="Red"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>